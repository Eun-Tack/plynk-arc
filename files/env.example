# ============================================
# plynk arc - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control!

# ============================================
# Supabase (Required)
# ============================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Public variables (safe to expose in client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Private variables (server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# AI - Gemini Flash (Required)
# ============================================
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Web Scraping - Jina Reader (Optional)
# ============================================
# Jina Reader API is free, but you can get an API key for higher limits
# Get from: https://jina.ai/reader
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# If not provided, will use the free public endpoint: https://r.jina.ai/

# ============================================
# Email - Resend (Required for Daily Summary)
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email sender domain (must be verified in Resend)
RESEND_FROM_EMAIL=daily@yourdomain.com

# ============================================
# Application Configuration
# ============================================
# Your application URL (for email links, OAuth redirects, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://plynkarc.com

# App name (used in emails, UI)
NEXT_PUBLIC_APP_NAME=plynk arc

# ============================================
# Feature Flags (Optional)
# ============================================
# Enable/disable features during development
NEXT_PUBLIC_ENABLE_DAILY_SUMMARY=true
NEXT_PUBLIC_ENABLE_SYNTHESIS=true
NEXT_PUBLIC_ENABLE_PDF_EXPORT=true
NEXT_PUBLIC_ENABLE_NOTION_EXPORT=true

# ============================================
# Analytics (Optional - Phase 2)
# ============================================
# Google Analytics
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# Error Tracking (Optional - Phase 2)
# ============================================
# Sentry
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Rate Limiting (Optional)
# ============================================
# Upstash Redis for rate limiting
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# External Integrations (Phase 2)
# ============================================
# Notion Integration
# NOTION_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NOTION_CLIENT_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe (for paid subscriptions)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# Development Only
# ============================================
# Set to 'development' or 'production'
NODE_ENV=development

# Enable Next.js debug mode
# DEBUG=true

# Disable telemetry
# NEXT_TELEMETRY_DISABLED=1

# ============================================
# Testing (Optional)
# ============================================
# Test database (Supabase local)
# SUPABASE_TEST_URL=http://localhost:54321
# SUPABASE_TEST_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mock AI responses for testing
# MOCK_AI_RESPONSES=false

# ============================================
# Notes
# ============================================
# 1. Required variables for basic functionality:
#    - NEXT_PUBLIC_SUPABASE_URL
#    - NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - SUPABASE_SERVICE_ROLE_KEY
#    - GEMINI_API_KEY
#    - RESEND_API_KEY
#
# 2. Optional but recommended:
#    - JINA_API_KEY (for higher rate limits)
#    - NEXT_PUBLIC_APP_URL (for production)
#
# 3. Phase 2 variables:
#    - Analytics (GA, PostHog)
#    - Error tracking (Sentry)
#    - Integrations (Notion, Stripe)
#
# 4. Security:
#    - NEVER commit .env.local to git
#    - Add .env.local to .gitignore
#    - Use different values for dev/prod
#    - Rotate keys regularly
#
# 5. Vercel Deployment:
#    - Add these variables in:
#      Project Settings > Environment Variables
#    - Select appropriate environments:
#      Production, Preview, Development
